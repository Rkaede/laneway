{
  "name": "laneway",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun scripts/generate-data.ts && vite",
    "build": "bun scripts/generate-data.ts && bun run typecheck && bunx vite build",
    "preview": "vite preview",
    "postinstall": "simple-git-hooks",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "test": "bun test",
    "test:e2e": "playwright test",
    "typecheck": "bunx tsc --noEmit && bunx tsc --noEmit -p tsconfig.node.json",
    "validate": "bun run format:check && bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.104",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/platform": "^0.2.1",
    "@solid-primitives/storage": "^4.4.0",
    "@solidjs/router": "^1.0.0",
    "ai": "^7.0.155",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk-solid": "^1.2.0",
    "codemirror-extension-inline-suggestion": "^0.0.3",
    "dequal": "^2.0.3",
    "html-to-image": "^1.11.13",
    "lucide-solid": "^1.62.0",
    "motion": "^14.7.1",
    "nanoid": "^6.0.2",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "solid-codemirror": "^2.3.3",
    "solid-js": "^1.9.17",
    "solid-markdown": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "babel-preset-solid": "^1.9.6",
    "eslint": "^10.13.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.18.1",
    "fake-indexeddb": "^6.2.6",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "shiki": "^4.5.0",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vite-plugin-solid": "^2.11.14",
    "workbox-build": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "simple-git-hooks": {
    "commit-msg": "bun scripts/verify-commit.js"
  },
  "overrides": {
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "glob": "^10.5.0",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.1",
    "mdast-util-to-hast": "^13.2.1",
    "minimatch": "^9.0.7",
    "picomatch": "^4.0.4",
    "rollup": "^4.60.2",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.5",
    "yaml": "^2.8.3"
  }
}

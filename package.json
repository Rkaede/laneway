{
  "name": "laneway",
  "private": true,
  "version": "0.0.0",
  "packageManager": "bun@1.3.0",
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development bun scripts/generate-data.ts && vite --force",
    "build": "bun scripts/generate-data.ts && bunx tsc && bunx vite build",
    "preview": "vite preview",
    "postinstall": "simple-git-hooks",
    "format": "prettier --log-level warn --write ./src",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "bun test ./**/*.test.*",
    "test:e2e": "playwright test",
    "typecheck": "bunx tsc --noEmit",
    "validate": "bun run format && bun run typecheck && bun run lint:fix && bun run test"
  },
  "dependencies": {
    "@ai-sdk/google": "4",
    "@ai-sdk/openai": "4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@kobalte/core": "^0.13.14",
    "@solid-primitives/platform": "0.2",
    "@solid-primitives/storage": "^4.4.0",
    "@solidjs/router": "1",
    "ai": "7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk-solid": "^1.2.0",
    "codemirror-extension-inline-suggestion": "^0.0.3",
    "dequal": "^2.0.3",
    "html-to-image": "^1.11.13",
    "lucide-solid": "1",
    "motion": "14",
    "nanoid": "6",
    "remark-gfm": "^4.0.1",
    "solid-codemirror": "^2.3.3",
    "solid-js": "^1.9.17",
    "solid-markdown": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "eslint": "9.x",
    "eslint-plugin-simple-import-sort": "14",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "17",
    "prettier": "3.5.3",
    "prettier-plugin-tailwindcss": "0.6.14",
    "shiki": "4",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^0.21.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "simple-git-hooks": {
    "commit-msg": "node scripts/verify-commit.js"
  },
  "overrides": {
    "@eslint/plugin-kit": "^0.3.4",
    "ajv": "^8.18.0",
    "brace-expansion": "^2.0.3",
    "flatted": "^3.4.2",
    "glob": "^10.5.0",
    "js-yaml": "^4.1.1",
    "lodash": "^4.18.1",
    "mdast-util-to-hast": "^13.2.1",
    "minimatch": "^9.0.7",
    "picomatch": "^4.0.4",
    "rollup": "^4.60.2",
    "serialize-javascript": "^7.0.5",
    "tmp": "^0.2.5",
    "vite": "^6.4.2",
    "yaml": "^2.8.3"
  }
}
